<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Sign in to The Blog Space.">
  <title>Sign in · The Blog Space</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="site-header">
    <a class="wordmark" href="/" aria-label="The Blog Space home">the blog <span>space</span></a>
    <a class="text-button" href="/signup">Create account</a>
  </header>

  <main class="auth-page">
    <section class="auth-intro">
      <p class="eyebrow">Welcome back</p>
      <h1>Your space<br>is <em>waiting.</em></h1>
      <p>Sign in to keep writing and catch up with the latest entries.</p>
    </section>
    <section class="composer-panel auth-panel" aria-labelledby="signin-title">
      <h2 id="signin-title">Sign in</h2>
      <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
      <form action="/signin" method="post" class="post-form">
        <label for="user-id">User ID</label>
        <input id="user-id" name="user_id" type="text" autocomplete="username" value="<%= draft.userId || '' %>" required maxlength="255">

        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required maxlength="128">

        <button class="button button-primary" type="submit">Sign in <span aria-hidden="true">↗</span></button>
      </form>
      <p class="auth-prompt">New to the blog? <a href="/signup">Create an account</a>.</p>
    </section>
  </main>

  <footer class="site-footer">
    <span>The Blog Space</span>
    <span>Made for thoughtful posts</span>
  </footer>
</body>
</html>
